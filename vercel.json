{
  "functions": {
    "api/og/member-node-default.js": {
      "includeFiles": "assets/kog/member-node-default.png"
    },
    "api/og/invite-card/[slug].js": {
      "includeFiles": "assets/kog/member-node-default.png"
    }
  },
  "rewrites": [
    { "source": "/api/og/k/:kac", "destination": "/api/og/k/:kac" },
    { "source": "/api/og/k-card/:kac", "destination": "/api/og/k-card/:kac" },
    { "source": "/api/og/system/:kac/:nodeId", "destination": "/api/og/system/:kac/:nodeId" },
    { "source": "/api/og/system-card/:kac/:nodeId", "destination": "/api/og/system-card/:kac/:nodeId" },
    { "source": "/api/og/h/:slug", "destination": "/api/og/h/:slug" },
    { "source": "/api/og/hub-card/:slug", "destination": "/api/og/hub-card/:slug" },
    { "source": "/api/og/invite/:slug", "destination": "/api/og/invite/:slug" },
    { "source": "/api/og/invite-card/:slug", "destination": "/api/og/invite-card/:slug" },
    { "source": "/api/og/message/:token", "destination": "/api/og/message/:token" },
    { "source": "/api/og/message-card/:token", "destination": "/api/og/message-card/:token" },
    { "source": "/og/member-node-default.png", "destination": "/api/og/member-node-default" },
    { "source": "/og/invite/:slug.png", "destination": "/api/og/invite-card/:slug" },
    { "source": "/og/k/:kac.png", "destination": "/api/og/k-card/:kac" },
    { "source": "/og/system/:kac/:nodeId.png", "destination": "/api/og/system-card/:kac/:nodeId" },
    { "source": "/og/h/:slug.png", "destination": "/api/og/hub-card/:slug" },
    { "source": "/og/message/:token.png", "destination": "/api/og/message-card/:token" },
    { "source": "/m/:token", "destination": "/api/og/message/:token" },
    { "source": "/invite/:slug", "destination": "/api/og/invite/:slug" },
    { "source": "/k/:kac/n/:nodeId", "destination": "/api/og/system/:kac/:nodeId" },
    { "source": "/k/:kac/source.json", "destination": "/api/k/:kac/source" },
    { "source": "/k/:kac/source", "destination": "/" },
    { "source": "/k/:kac/actions", "destination": "/" },
    { "source": "/k/:kac", "destination": "/api/og/k/:kac" },
    { "source": "/h/:slug", "destination": "/api/og/h/:slug" },
    { "source": "/((?!api/|_expo/|assets/).*)", "destination": "/" }
  ]
}
