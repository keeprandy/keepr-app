{
  "expo": {
    "name": "Keepr™",
    "slug": "keepr",
    "version": "1.0.7",
    "runtimeVersion": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "keepr",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keeprhome.app",
      "buildNumber": "40",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos for your asset records and proof.",
        "NSPhotoLibraryUsageDescription": "Upload photos and documents to your assets.",
        "NSContactsUsageDescription": "Contacts are used to associate service providers (KeeprPros) with assets, maintain service records, and invite them to participate in Keepr.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.keeprhome.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
"web": {
  "favicon": "./assets/favicon-48.png"
},
"plugins": [
  [
    "expo-share-intent",
    {
      "ios": {
        "enabled": true,
        "activationRule": {
          "NSExtensionActivationSupportsText": true,
          "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
          "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
          "NSExtensionActivationSupportsImageWithMaxCount": 10,
          "NSExtensionActivationSupportsFileWithMaxCount": 10
        }
      },
      "android": {
        "enabled": true,
        "singleShareMimeTypes": ["text/*", "image/*", "application/pdf", "*/*"],
        "multipleShareMimeTypes": ["image/*", "application/pdf", "*/*"]
      }
    }
  ],

  "./plugins/withShareExtensionFix"

],
"extra": {
  "eas": {
    "projectId": "7705d387-cff3-4310-b835-58cf3dfac948"
  }
},
    "updates": {
      "url": "https://u.expo.dev/7705d387-cff3-4310-b835-58cf3dfac948"
    } 
  }
}